<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- PR-2b — create/rename folder modal (IMAP-first endpoints behind it). -->
    <t t-name="mail_management.FolderDialog" owl="1">
        <Dialog title="title">
            <div class="o_webmail_folder_dialog d-flex flex-column gap-2">
                <div t-if="isCreate &amp;&amp; props.mailboxes.length &gt; 1">
                    <label class="form-label small fw-bold" for="o_webmail_folder_dialog_mailbox">Mailbox</label>
                    <select id="o_webmail_folder_dialog_mailbox"
                            class="form-select o_webmail_folder_dialog_mailbox"
                            t-att-value="state.mailboxId"
                            t-on-change="setMailbox">
                        <option t-foreach="props.mailboxes" t-as="mb" t-key="mb.id"
                                t-att-value="mb.id" t-out="mb.name"/>
                    </select>
                </div>
                <div>
                    <label class="form-label small fw-bold" for="o_webmail_folder_dialog_name">Folder name</label>
                    <input id="o_webmail_folder_dialog_name"
                           type="text"
                           class="form-control o_webmail_folder_dialog_name"
                           t-att-value="state.name"
                           placeholder="e.g. Projects"
                           t-on-input="setName"/>
                    <div class="form-text">
                        Simple folder names only (no "/" or "." — sub-folders are not supported yet).
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary o_webmail_folder_dialog_confirm"
                        t-att-disabled="canConfirm ? null : 'disabled'"
                        t-on-click="onConfirm">
                    <span t-out="confirmLabel"/>
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="() => this.props.close()">
                    Discard
                </button>
            </t>
        </Dialog>
    </t>
</templates>
