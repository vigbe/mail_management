<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mail_management_connection_wizard_form" model="ir.ui.view">
        <field name="name">mail.management.connection.wizard.form</field>
        <field name="model">mail.management.connection.wizard</field>
        <field name="arch" type="xml">
            <form string="Probar conexión">
                <sheet>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="fa fa-exclamation-triangle text-warning fs-2"
                           role="img" aria-label="Atención"/>
                        <h2 class="mb-0">
                            <field name="title" readonly="1" nolabel="1"/>
                        </h2>
                    </div>
                    <field name="mailbox_id" invisible="1"/>
                    <field name="link_url" invisible="1"/>
                    <field name="message" nolabel="1" readonly="1"/>
                    <details class="mt-3">
                        <summary class="text-muted small">
                            Detalle técnico del error
                        </summary>
                        <field name="raw_error" readonly="1"
                               class="text-muted small mt-2"/>
                    </details>
                </sheet>
                <footer>
                    <button name="action_open_link" type="object"
                            string="Abrir ayuda del proveedor"
                            class="btn-primary" icon="fa-external-link"
                            attrs="{'invisible': [('link_url', '=', False)]}"/>
                    <button special="cancel" string="Entendido"
                            class="btn-secondary ms-2" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
