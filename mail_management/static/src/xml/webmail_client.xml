<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- PR-1b-ii — WebmailClient root: 3-pane read-only layout.
         All rendering uses t-out (never t-raw). -->
        <t t-name="mail_management.WebmailClient" owl="1">
            <!-- PR-2g: the theme is a root class — the palette lives on CSS
                 custom properties (webmail.scss); dark only overrides them. -->
            <div class="o_webmail_client d-flex w-100 h-100 overflow-hidden"
                 t-ref="this.rootEl"
                 t-att-class="this.themeClass"
                 t-on-mounted="this.applySavedWidths">
                <FolderTree
                    mailboxes="this.state.mailboxes"
                    selectedMailboxId="this.state.selectedMailboxId"
                    selectedFolderId="this.state.selectedFolderId"
                    loading="this.state.loadingFolders"
                    refreshing="this.state.refreshing"
                    showUnreadBadge="this.state.settings.showUnreadBadge"
                    onSelectFolder.bind="this.selectFolder"
                        onSelectMailbox.bind="this.selectMailbox"
                    onConfigure.bind="this.openMailboxConfig"
                        onConfigureMailbox.bind="this.configureMailbox"
                    onAddMailbox.bind="this.openAddMailbox"
                    onRefreshAll.bind="this.refreshAll"
                    onOpenSettings.bind="this.openSettings"
                    onCreateFolder.bind="this.openCreateFolderDialog"
                    onRenameFolder.bind="this.openRenameFolderDialog"
                    onDeleteFolder.bind="this.onDeleteFolder"
                    onHideFolder.bind="this.hideFolder"/>
<div class="o_webmail_splitter" role="separator" aria-orientation="vertical"
                     t-on-pointerdown="ev => this.startSplitterDrag('tree', ev)"/>
            <MessageList
                messages="this.state.messages"
                loading="this.state.loadingMessages"
                selectedMessageId="this.state.selectedMessageId"
                sortBy="this.state.messageSort"
                priority="this.state.messagePriority"
                filter="this.state.messageFilter"
                selectedIds="this.state.selectedIds"
                folderName="this.state.selectedFolderName"
                showCheckboxes="this.state.settings.showCheckboxes"
                searchQuery="this.state.searchQuery"
                moveTargets="this.moveTargets"
                isTrash="this.viewingTrash"
                onOpenMessage.bind="this.openMessage"
                onSetSort.bind="this.setSort"
                onTogglePriority.bind="this.togglePriority"
                onSetFilter.bind="this.setFilter"
                onToggleStar.bind="this.toggleStar"
                onToggleSelect.bind="this.toggleSelect"
                onToggleSelectAll.bind="this.toggleSelectAll"
                onBulkSetFlags.bind="this.bulkSetFlags"
                onMoveToFolder.bind="this.bulkMoveToFolder"
                onDeleteMessages.bind="this.bulkDeleteMessages"
                onComposeNew.bind="() => this.openCompose('new')"
                onSearch.bind="this.applySearch"
                onClearSearch.bind="this.clearSearch"/>
<div class="o_webmail_splitter" role="separator" aria-orientation="vertical"
                     t-on-pointerdown="ev => this.startSplitterDrag('list', ev)"/>
            <ReadingPane
                message="this.state.selectedMessage"
                loading="this.state.loadingMessage"
                moveTargets="this.moveTargets"
                isTrash="this.viewingTrash"
                imagesBlocked="this.imagesBlockedForOpen"
                simpleAttachmentList="this.state.settings.simpleAttachmentList"
                onCompose.bind="this.openCompose"
                onToggleStar.bind="this.toggleStar"
                onMarkUnread.bind="this.markUnread"
                onMoveToFolder.bind="this.moveOpenMessage"
                onDeleteMessage.bind="this.deleteOpenMessage"
                onShowImages.bind="this.showImages"
                onToggleAssistant.bind="this.toggleAssistant"
                assistantOpen="this.state.assistantOpen"/>
        
                <AssistantPanel t-if="this.state.assistantOpen &amp;&amp; this.state.selectedMailboxId"
                               mailboxId="this.state.selectedMailboxId"
                               mailboxName="this.state.selectedFolderName || ''"
                               selectedMessage="this.state.selectedMessage"
                               onClose.bind="this.toggleAssistant"
                               onOpenMessage="(m) => this.openMessage(m)"
                               onDraftReady.bind="this.openAiDraft"/>
            </div>
    </t>
</templates>
