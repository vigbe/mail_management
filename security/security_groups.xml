<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module category (ir.module.category still exists in Odoo 19) -->
    <record id="module_category_mail_management" model="ir.module.category">
        <field name="name">Mail Management</field>
        <field name="sequence">50</field>
    </record>

    <!-- Odoo 18: groups reference the module category directly via
         category_id (res.groups.privilege only exists in Odoo 19+). -->
    <record id="group_mail_management_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_mail_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_mail_management_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_mail_management"/>
        <field name="implied_ids" eval="[(4, ref('group_mail_management_user'))]"/>
    </record>

    <!-- ================================================================ -->
    <!-- Per-user ir.rule isolation (design B.3)                          -->
    <!-- TWO group-scoped rules (NOT a global own-only rule):             -->
    <!--   - user  sees only own mailboxes: [('user_id','=',user.id)]     -->
    <!--   - manager sees ALL mailboxes:      [(1,'=',1)]                 -->
    <!-- A manager (implied into user) gets own OR all = all.             -->
    <!-- ================================================================ -->
    <record id="rule_mailbox_user_own" model="ir.rule">
        <field name="name">Mailbox: user sees own</field>
        <field name="model_id" ref="model_mail_management_mailbox"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_mail_management_user'))]"/>
    </record>
    <record id="rule_mailbox_manager_all" model="ir.rule">
        <field name="name">Mailbox: manager sees all</field>
        <field name="model_id" ref="model_mail_management_mailbox"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mail_management_manager'))]"/>
    </record>

    <!-- ================================================================ -->
    <!-- Folder isolation (PR-1b-i — design B.3)                          -->
    <!-- ================================================================ -->
    <record id="rule_folder_user_own" model="ir.rule">
        <field name="name">Folder: user sees own</field>
        <field name="model_id" ref="model_mail_management_folder"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_mail_management_user'))]"/>
    </record>
    <record id="rule_folder_manager_all" model="ir.rule">
        <field name="name">Folder: manager sees all</field>
        <field name="model_id" ref="model_mail_management_folder"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mail_management_manager'))]"/>
    </record>

    <!-- ================================================================ -->
    <!-- Message isolation (PR-1b-i — design B.3)                         -->
    <!-- ================================================================ -->
    <record id="rule_message_user_own" model="ir.rule">
        <field name="name">Message: user sees own</field>
        <field name="model_id" ref="model_mail_management_message"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_mail_management_user'))]"/>
    </record>
    <record id="rule_message_manager_all" model="ir.rule">
        <field name="name">Message: manager sees all</field>
        <field name="model_id" ref="model_mail_management_message"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mail_management_manager'))]"/>
    </record>

    <!-- ================================================================ -->
    <!-- Attachment isolation (PR-1b-i — design B.3)                      -->
    <!-- ================================================================ -->
    <record id="rule_attachment_user_own" model="ir.rule">
        <field name="name">Attachment: user sees own</field>
        <field name="model_id" ref="model_mail_management_attachment"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_mail_management_user'))]"/>
    </record>
    <record id="rule_attachment_manager_all" model="ir.rule">
        <field name="name">Attachment: manager sees all</field>
        <field name="model_id" ref="model_mail_management_attachment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mail_management_manager'))]"/>
    </record>
    <!-- ================================================================
         Signature isolation (PR-2c — same pattern as the mailbox rules)
    ================================================================ -->
    <record id="rule_signature_user_own" model="ir.rule">
        <field name="name">Signature: user sees own</field>
        <field name="model_id" ref="model_mail_management_signature"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_mail_management_user'))]"/>
    </record>
        <record id="rule_signature_manager_all" model="ir.rule">
            <field name="name">Signature: manager sees all</field>
            <field name="model_id" ref="model_mail_management_signature"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_management_manager'))]"/>
        </record>
        <!-- ================================================================
             Settings isolation (PR-2e — same pattern: user = own singleton,
             manager = all; the /settings endpoints always pin env.user)
        ================================================================ -->
        <record id="rule_settings_user_own" model="ir.rule">
            <field name="name">Webmail settings: user sees own</field>
            <field name="model_id" ref="model_mail_management_settings"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_mail_management_user'))]"/>
        </record>
        <record id="rule_settings_manager_all" model="ir.rule">
            <field name="name">Webmail settings: manager sees all</field>
            <field name="model_id" ref="model_mail_management_settings"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_mail_management_manager'))]"/>
        </record>
        <!-- Install default (S9): the DEFAULT admin login (base.user_admin)
         can use the module from the start. ONLY this user is granted
         anything automatically — no other user, other admins included,
         receives the group without an explicit assignment. -->
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_mail_management_manager'))]"/>
    </record>
</odoo>
