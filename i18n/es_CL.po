#. odoo-javascript
#: code:addons/mail_management/static/src/webmail_client.js:0
msgid "'%s' was demoted to Other (one folder per role)."
msgstr "'%s' pasó a Otro (una carpeta por rol)."

#. module: mail_management
#. odoo-python
#: code:addons/mail_management/models/mail_management.py:0
msgid "The folder '%s' is a mapped system folder. Remove its role in Settings ▸ Folders before deleting it."
msgstr "La carpeta '%s' es una carpeta del sistema asignada. Quite su rol en Configuración ▸ Carpetas antes de eliminarla."

#. module: mail_management
#. odoo-python
#: code:addons/mail_management/models/mail_management.py:0
msgid "No Trash folder is mapped for this mailbox. Map one in Settings ▸ Folders first."
msgstr "No hay ninguna carpeta de Papelera asignada a este buzón. Asigne una primero en Configuración ▸ Carpetas."

#. module: mail_management
#. odoo-javascript
#: code:addons/mail_management/static/src/webmail_client.js:0
msgid "Delete the folder '%s' with %s message(s)? Messages will be moved to Trash and automatically deleted after %s days."
msgstr "¿Eliminar la carpeta '%s' con %s mensaje(s)? Los mensajes se moverán a la Papelera y se eliminarán automáticamente después de %s días."

#. module: mail_management
#. odoo-javascript
#: code:addons/mail_management/static/src/webmail_client.js:0
msgid "Folder deleted. %s message(s) moved to Trash."
msgstr "Carpeta eliminada. %s mensaje(s) movidos a la Papelera."

#. module: mail_management
#. odoo-javascript
#: code:addons/mail_management/static/src/components/settings_dialog.js:0
msgid "Trash retention (days)"
msgstr "Retención de la Papelera (días)"

#. module: mail_management
#. odoo-javascript
#: code:addons/mail_management/static/src/components/settings_dialog.js:0
msgid "Trashed messages are permanently deleted after this many days (1-365)."
msgstr "Los mensajes de la Papelera se eliminan definitivamente tras este número de días (1-365)."

#. module: mail_management
#. odoo-javascript
#: code:addons/mail_management/static/src/components/settings_dialog.js:0
msgid "Mapped system folders cannot be deleted. Unmap the role first."
msgstr "Las carpetas del sistema asignadas no se pueden eliminar. Quite el rol primero."


